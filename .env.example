# Copy this file to .env.local for local development.
# Real secrets should never be committed.
VITE_API_URL=http://127.0.0.1:8000
TEST_USER_ID=your-test-user-id
VITE_TEST_USER_ID=your-test-user-id
ALLOW_DEV_BYPASS_AUTH=true
VITE_ENABLE_DEV_BYPASS=true

# NSRDB Weather API Credentials (NREL)
NSRDB_API_KEY=your-nsrdb-api-key
NSRDB_EMAIL=your-email@example.com
